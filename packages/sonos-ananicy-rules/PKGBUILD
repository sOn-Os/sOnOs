# Maintainer: sOnOs <https://github.com/sOn-Os>
#
# Process rules for ananicy-cpp, from CachyOS: nice levels, I/O classes and scheduling
# policies for about 360 programs (games, compilers, browsers, desktop services). Arch's
# ananicy-cpp ships no rules, so without this package it does nothing.
#
# To update: put the newest commit of https://github.com/CachyOS/ananicy-rules in _commit
# and its commit date in pkgver.

pkgname=sonos-ananicy-rules
_commit=03ef03fbf7e834385377432ccecaedd32e3414bb
pkgver=20260908
pkgrel=1
pkgdesc='ananicy-cpp rules from CachyOS, for sOnOs'
arch=('any')
url='https://github.com/CachyOS/ananicy-rules'
license=('GPL-3.0-or-later')
depends=('ananicy-cpp')
makedepends=('git')
provides=('ananicy-rules')
conflicts=('cachyos-ananicy-rules' 'cachyos-ananicy-rules-git' 'ananicy-rules-git')
backup=('etc/ananicy.d/ananicy.conf')
source=("ananicy-rules::git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

package() {
	cd ananicy-rules

	install -d "${pkgdir}/etc/ananicy.d"
	cp -r --no-preserve=ownership 00-default "${pkgdir}/etc/ananicy.d/"
	install -m644 00-cgroups.cgroups 00-types.types ananicy.conf "${pkgdir}/etc/ananicy.d/"
	find "${pkgdir}/etc/ananicy.d" -type d -exec chmod 755 {} +
	find "${pkgdir}/etc/ananicy.d" -type f -exec chmod 644 {} +
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
